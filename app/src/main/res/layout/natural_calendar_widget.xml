<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="18dp"
    android:background="@drawable/widget_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="NATURAL CALENDAR"
        android:textColor="#D9B55A"
        android:textSize="10sp"
        android:letterSpacing="0.18"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/widgetNaturalDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Month 7 · Day 2"
        android:textColor="#FFF9ED"
        android:textSize="26sp"
        android:textStyle="bold"
        android:maxLines="1"/>

    <TextView
        android:id="@+id/widgetMoonStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="◔  Waxing Crescent · 3%"
        android:textColor="#E6EBF2"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"/>

    <TextView
        android:id="@+id/widgetSunStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="☀  Day · 28°"
        android:textColor="#E8C96A"
        android:textSize="13sp"
        android:maxLines="1"/>

    <TextView
        android:id="@+id/widgetCivilDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:text="Sat, 12 Sep"
        android:textColor="#A7B2C2"
        android:textSize="12sp"/>
</LinearLayout>
